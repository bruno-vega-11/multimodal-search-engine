# Copia este archivo a ".env" y ajusta los valores si lo necesitas.
# Con Docker Compose estos mismos valores alimentan el contenedor de Postgres
# y el backend; en ejecución manual, db.py y backend.py los leen vía dotenv.

# --- PostgreSQL ---
POSTGRES_DB=sistema_multimodal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

PGHOST=localhost
PGPORT=5433
PGDATABASE=sistema_multimodal
PGUSER=postgres
PGPASSWORD=123456

# --- Backend ---
# URL pública con la que el backend arma los links de streaming de audio/imagen.
BASE_URL=http://localhost:8000
